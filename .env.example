DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USERNAME=typeorm_user
DATABASE_PASSWORD=secret
DATABASE_NAME=typeorm_learning
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=true

BACKEND_DOMAIN=http://localhost:3000
FRONTEND_DOMAIN=http://localhost:3001

AUTH_JWT_SECRET=secret
AUTH_JWT_TOKEN_EXPIRES_IN=15m
AUTH_MAGIC_LINK_TOKEN_EXPIRES_IN=15m
AUTH_OTP_SECRET=secret_for_otp
AUTH_OTP_TOKEN_EXPIRES_IN=10m
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_ONE_TIME_TOKEN_RETENTION=7d

FILE_DRIVER=local
ACCESS_KEY_ID=test
SECRET_ACCESS_KEY=test
AWS_S3_REGION=us-east-1
AWS_DEFAULT_S3_BUCKET=nest-files
AWS_S3_ENDPOINT=http://localhost:4566

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_IGNORE_TLS=true
MAIL_SECURE=false
MAIL_REQUIRE_TLS=false
MAIL_DEFAULT_EMAIL=noreply@example.com
MAIL_DEFAULT_NAME=Api

LOCALSTACK_AUTH_TOKEN=
